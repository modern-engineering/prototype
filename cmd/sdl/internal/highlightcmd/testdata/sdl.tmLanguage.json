{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "information_for_contributors": [
    "Generated by sdl highlight vscode from the toolchain's grammar code;",
    "regenerate instead of editing, or the file drifts from the grammar."
  ],
  "name": "SDL",
  "scopeName": "source.sdl",
  "fileTypes": [
    "sdl"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#section"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#boolean"
    },
    {
      "include": "#field"
    },
    {
      "include": "#duration"
    },
    {
      "include": "#int"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "boolean": {
      "name": "constant.language.boolean.sdl",
      "match": "\\b(?:false|true)\\b"
    },
    "comment": {
      "name": "comment.line.double-slash.sdl",
      "match": "//.*$"
    },
    "duration": {
      "name": "constant.numeric.duration.sdl",
      "match": "(?<![\\w.])[+-]?\\d+[A-Za-z_.][A-Za-z0-9_.]*"
    },
    "field": {
      "name": "support.type.property-name.sdl",
      "match": "\\b(?:location)\\b(?=\\s*:)"
    },
    "int": {
      "name": "constant.numeric.integer.sdl",
      "match": "(?<![\\w.])[+-]?\\d+(?![\\w.])"
    },
    "keyword": {
      "name": "keyword.control.sdl",
      "match": "\\b(?:as|default|deploy|extern|import|provision|solution|var)\\b"
    },
    "punctuation": {
      "name": "punctuation.other.sdl",
      "match": "[{}():.]"
    },
    "section": {
      "match": "\\b(metadata|params|with)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*))?",
      "captures": {
        "1": {
          "name": "keyword.other.section.sdl"
        },
        "2": {
          "name": "entity.name.namespace.qualifier.sdl"
        }
      }
    },
    "string": {
      "name": "string.quoted.double.sdl",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.sdl",
          "match": "\\\\(?:[abfnrtv\\\\\"]|[0-7]{3}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        },
        {
          "name": "invalid.illegal.escape.sdl",
          "match": "\\\\."
        }
      ]
    }
  }
}
