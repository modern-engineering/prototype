// The detection unit correlates identity observations and fans resulting
// security alerts out to durable storage and the customer's SIEM.
solution anomaly

import (
	"github.com/modern-engineering/prototype/fieldcase/catalog/detection"
)

deploy detection.IdentityAnomalyDetector as identityAnomalyDetector {
	params {
		// Detect a known identity arriving from an unexpected network endpoint.
		policyRuleName: "UnexpectedEndpoint"
		handlersLimit: 10

		// Keep correlation state in an account dedicated to this detector.
		redisAddress: identityState.address
		redisDBNumber: identityState.db
		redisUsername: identityState.username
		redisPassword: identityState.password

		consumesGraphChanged: topicGraphChanged
		producesAlerts: topicAlerts
	}

	with k8s.pod {
		cpu: "300m"
		memory: "250Mi"
	}
	metadata {
		chart: "identity-anomaly-detector"
		component: "identity-anomaly-detector"
	}
}

// The journal and exporter consume the same alert stream independently.
deploy detection.Journal as detectionAlertsJournal {
	params {
		postgresRoleName: "postgrest_view" // the role PostgREST queries with

		postgresAddress: alertsDB.address
		postgresUsername: alertsDB.username
		postgresPassword: alertsDB.password
		postgresDBName: alertsDB.database

		consumesAlerts: topicAlerts
	}

	with k8s.pod {
		cpu: "300m"
		memory: "250Mi"
	}
	metadata {
		chart: "detection-alerts-journal"
		component: "detection-alerts-journal"
	}
}

// Sites with a SIEM enable the exporter as the egress edge of the flow.
deploy detection.SyslogExporter as detectionSyslogExporter {
	params {
		format: "rfc5424"
		protocol: "udp"
		serverAddress: siemServer // each site binds its own SIEM endpoint
		timeout: 10s

		consumesAlerts: topicAlerts
	}

	with k8s.pod {
		cpu: "300m"
		memory: "250Mi"
	}
	metadata {
		chart: "detection-syslog-exporter"
		component: "detection-syslog-exporter"
	}
}
