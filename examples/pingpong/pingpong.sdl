// The pingpong solution deploys two ping services against one pong,
// exercising the I1 language subset: imports, deploys, literal params.
solution pingpong

import ff "github.com/modern-engineering/prototype/examples/ff"

deploy ff.Ping as Ping1 {
	params {
		count: 3
		interval: 500ms
		target: "pong"
	}
}

deploy ff.Ping as Ping2 {
	params {
		count: -1
		interval: 2s
		target: "pong"
	}
}
